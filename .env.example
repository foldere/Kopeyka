DB_PASS=secret
MYSQL_ROOT_PASSWORD=rootsecret

# Откуда брать курсы валют:
#   static   — фиксированные демо-курсы (работает без интернета)
#   cbr_xml  — курсы ЦБ РФ в формате XML
#   cbr_json — курсы ЦБ РФ в формате JSON (зеркало cbr-xml-daily.ru)
RATE_PROVIDER=static

APP_TZ=Asia/Yekaterinburg
