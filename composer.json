{
    "name": "student/kopeyka",
    "description": "Копейка — REST API для учёта личных финансов (PHP 8, MySQL, курсы ЦБ РФ)",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-mbstring": "*",
        "ext-simplexml": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": { "App\\": "src/" }
    },
